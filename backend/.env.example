# ---------------------------------------------------------------------------
# Eventra environment configuration. Copy to backend/.env and fill in.
# NEVER commit a real key. The frontend has no access to any of these values.
# ---------------------------------------------------------------------------

# --- Qwen LLM (required for live analysis; omit to run in Demo Mode) -------
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=2
QWEN_TEMPERATURE=0.2

# --- Runtime mode ----------------------------------------------------------
# Demo Mode allows the deterministic mock interpreter when no key is present.
EVENTRA_DEMO_MODE=true
# Hard guarantee. Setting this to false does NOT enable live trading;
# the execution service raises instead. Paper trading only, always.
EVENTRA_PAPER_TRADING_ONLY=true

# --- Database --------------------------------------------------------------
# PostgreSQL:  postgresql+psycopg2://eventra:eventra@localhost:5432/eventra
# SQLite:      sqlite:///./data/eventra.db
DATABASE_URL=postgresql+psycopg2://eventra:eventra@localhost:5432/eventra
# Force a store: sql | json   (auto-detected when unset)
EVENTRA_STORE=
EVENTRA_DATA_DIR=

# --- Portfolio -------------------------------------------------------------
EVENTRA_STARTING_BALANCE=1000000

# --- Risk limits (deterministic; the LLM can never change these) -----------
EVENTRA_MAX_POSITION_WEIGHT_PCT=25
EVENTRA_MAX_GROSS_EXPOSURE_PCT=90
EVENTRA_MAX_TRADE_NOTIONAL=150000
EVENTRA_MAX_SINGLE_TRADE_PCT=12
EVENTRA_MAX_DAILY_LOSS_PCT=4
EVENTRA_MIN_CONFIDENCE=0.60
EVENTRA_MIN_ADV_USD=250000000
EVENTRA_MAX_TRADE_ADV_PCT=2
EVENTRA_MAX_ANNUALIZED_VOL=0.90
EVENTRA_DUPLICATE_COOLDOWN_MIN=30
EVENTRA_MAX_ACTIONS_PER_DECISION=6

# --- Optional live news provider (leave blank for the seeded demo feed) ----
EVENTRA_NEWS_URL=
EVENTRA_NEWS_TOKEN=
EVENTRA_NEWS_ITEMS_KEY=results

# --- API -------------------------------------------------------------------
EVENTRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
