# Eventra frontend configuration.
# The Next.js dev server proxies /api/* to this URL (see next.config.mjs),
# so the browser never needs the API key or a direct cross-origin call.
EVENTRA_API_URL=http://127.0.0.1:8000

# Only needed if you disable the rewrite proxy and call the API cross-origin.
NEXT_PUBLIC_EVENTRA_API_URL=